# Local settings; Django loads .env from the project directory.
# Keep the real .env private and never commit secrets.
DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mysql
DB_NAME=sentinelpay
DB_USER=root
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
# Dashboard refresh interval in milliseconds.
TRANSACTION_MONITOR_POLL_INTERVAL_MS=5000
# Used only by `manage.py seed_demo`. Minimum 12 characters.
DEMO_PASSWORD=replace-with-demo-password
